# Supabase — auth + chat backend.
# Copy to .env and fill with your project's values (Project Settings → API Keys).
# Use the NEW "publishable" key (sb_publishable_...), not the legacy anon key.
# NEVER put the secret key (sb_secret_...) here — EXPO_PUBLIC_* is shipped in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
