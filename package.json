    "babel-preset-expo": "^14.0.6",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.4",
    "typescript": "~5.8.3"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}