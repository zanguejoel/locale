{
  "name": "locale",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "detox test",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:ios:release": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:android:release": "detox test --configuration android.emu.release",
    "build:e2e:ios": "detox build --configuration ios.sim.debug",
    "build:e2e:ios:release": "detox build --configuration ios.sim.release",
    "build:e2e:android": "detox build --configuration android.emu.debug",
    "build:e2e:android:release": "detox build --configuration android.emu.release",
    "e2e:ios": "npm run build:e2e:ios && npm run test:e2e:ios",
    "e2e:android": "npm run build:e2e:android && npm run test:e2e:android",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "bash scripts/patch-expo-localization.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native|@react-native-community|expo(nent)?|@expo(nent)?|@expo-google-fonts|react-navigation|@react-navigation|@unimodules|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/jest.setup.js",
      "!**/__tests__/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 60,
        "functions": 70,
        "lines": 70
      }
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.26.7",
    "@craftzdog/react-native-buffer": "^6.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "^4.5.6",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/drawer": "^7.5.9",
    "@react-navigation/elements": "^2.2.5",
    "@react-navigation/native": "^7.1.18",
    "@shopify/flash-list": "^1.7.6",
    "@shopify/react-native-skia": "2.0.0-next.4",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.66.0",
    "apisauce": "^3.1.0",
    "assert": "^2.0.0",
    "av": "^0.4.9",
